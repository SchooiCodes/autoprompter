{
  "name": "autoprompter",
  "version": "1.0.0",
  "description": "OpenCode V2 plugin that rewrites user prompts with the prompt-design skill using an auto-selected free model",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "files": [
    "src",
    "skill",
    "vendor",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "prompt",
    "prompt-optimizer",
    "prompt-design"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SchooiCodes/autoprompter.git"
  },
  "bugs": {
    "url": "https://github.com/SchooiCodes/autoprompter/issues"
  },
  "homepage": "https://github.com/SchooiCodes/autoprompter#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@opencode/plugin": "^2.3.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
